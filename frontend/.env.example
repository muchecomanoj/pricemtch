# Copy to .env.local and adjust.

# false = call the live Spring Boot API; true = dummy JSON (offline demo).
VITE_USE_MOCK=false

# Base path. Requests hit /api/v1 and are proxied to the backend (see vite.config.js).
# Keep this relative — the proxy makes calls same-origin, so no CORS is needed.
VITE_API_BASE_URL=/api/v1

# Which backend the proxy targets is chosen by mode, not here:
#   npm run dev          -> .env.development -> http://localhost:8080
#   npm run dev:shared   -> .env.shared      -> http://192.168.10.253:8080
# Set VITE_API_PROXY_TARGET here only to override both on your machine.

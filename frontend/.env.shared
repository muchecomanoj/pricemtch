# Mode: shared — the DEFAULT (`npm run dev`, `npm start`, `npm run dev:shared`)
# The team's shared backend. Calls go DIRECTLY to it, so the browser's network
# tab shows 192.168.10.253:8080 (not the dev server's own host:port).
# Works because the backend allows CORS from any origin.
VITE_API_BASE_URL=http://192.168.10.253:8080/api/v1

# Only used if VITE_API_BASE_URL is relative (/api/v1) — kept so you can switch
# back to same-origin proxying without editing anything else.
VITE_API_PROXY_TARGET=http://192.168.10.253:8080

# Must be present and false. api.js defaults to MOCK when this is unset, so a
# fresh clone (no .env.local) would serve dummy data with no sign it is fake.
VITE_USE_MOCK=false

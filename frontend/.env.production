# Mode: production — `npm run build:prod`, the build that goes on the server.
#
# Relative, NOT a host. The browser calls the same domain it loaded the page
# from, and Nginx forwards /api to the Spring Boot backend — so the build works
# on any domain and the backend needs no CORS config.
#
# Never point this at an IP: whatever is here is compiled into the JavaScript,
# and every customer's browser would then call that machine.
VITE_API_BASE_URL=http://88.208.224.110/pricematch-api

VITE_API_PROXY_TARGET=http://88.208.224.110/pricematch-api

# Must be present and false. api.js defaults to MOCK when this is unset, so a
# build without it serves dummy data with no visible sign that it is fake.
VITE_USE_MOCK=false

# Mode: development — `npm run dev:local`
# Only works if YOU are running the Spring Boot backend on this machine.
# Calls go DIRECTLY to it.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Only used if VITE_API_BASE_URL is relative (/api/v1) — kept so you can switch
# back to same-origin proxying without editing anything else.
VITE_API_PROXY_TARGET=http://localhost:8080

# Must be present and false. api.js defaults to MOCK when this is unset, so a
# fresh clone (no .env.local) would serve dummy data with no sign it is fake.
VITE_USE_MOCK=false

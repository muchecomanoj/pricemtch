# =============================================================
#  Environment variables for the Price Intelligence backend
#
#  Copy the values you need into your launch script (run-backend.ps1 locally,
#  which is git-ignored) or set them in your deployment environment.
#
#  Nothing here is a real secret. application.properties deliberately ships
#  without working defaults for these, so a missing value fails loudly instead
#  of silently running on a key that is published in the source tree.
# =============================================================

# ---- Required in any deployed environment -------------------

# Encrypts stored marketplace credentials, SMTP passwords and webhook URLs.
# Use a long random string. WARNING: changing this makes existing encrypted
# values undecryptable — they must be re-entered on the Settings screens.
CRYPTO_SECRET=

# Signs login tokens. Minimum 32 characters for HS256. Anyone holding this can
# mint a valid token for any user.
JWT_SECRET=

# Makes placeholder secrets fatal at startup rather than a warning.
# Set true wherever this is deployed.
SECURITY_STRICT_SECRETS=true

# Browser origins allowed to call the API, comma-separated. Do not use "*" —
# the API is called with credentials.
CORS_ALLOWED_ORIGINS=https://app.example.com

# ---- Database ------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/price_intel
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ---- Outgoing email ------------------------------------------
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Gmail requires an App Password, not the account password.
MAIL_PASSWORD=
MAIL_FROM=

# ---- Marketplaces --------------------------------------------
# Amazon SP-API. Authorisation is per marketplace region: credentials valid for
# North America return HTTP 403 for Europe, India and the Far East.
AMAZON_SPAPI_ENABLED=false
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_SPAPI_REGION=NA

# eBay Browse API. Sandbox and production use DIFFERENT keysets — sandbox keys
# return 401 against production. One production keyset covers every eBay region.
EBAY_ENABLED=false
EBAY_ENV=PRODUCTION
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Keepa — Amazon product and price data by ASIN, no seller authorisation needed.
# domain: 1=US, 2=UK, 3=DE, 10=IN
KEEPA_ENABLED=false
KEEPA_API_KEY=
KEEPA_DOMAIN=1

# ---- Payments ------------------------------------------------
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- AI ------------------------------------------------------
OPENAI_ENABLED=false
OPENAI_API_KEY=

# ---- Scheduled work ------------------------------------------
MONITORS_ENABLED=true
MONITORS_TICK_MS=300000
MONITORS_BATCH_SIZE=10
COMPETITOR_CACHE_TTL_HOURS=48

# ---- Front-end link in emails --------------------------------
# Must be reachable by the recipient's browser — never localhost, or activation
# links open on the recipient's own machine.
FRONTEND_URL=
